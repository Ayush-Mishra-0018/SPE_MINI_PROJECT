pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'ayushmishra0018/calculator-devops'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKERHUB_USERNAME = 'ayushmishra0018'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('calculator-devops') {
                    sh 'chmod +x mvnw'
                    sh './mvnw -B -DskipTests clean package'
                }
            }
        }

        stage('Test') {
            steps {
                dir('calculator-devops') {
                    sh './mvnw -B test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'calculator-devops/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('calculator-devops') {
                    sh '''
                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKER_TOKEN" | docker login \
                            --username "$DOCKER_USER" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                dir('calculator-devops') {
                    sh '''
                        export DOCKERHUB_USERNAME="${DOCKERHUB_USERNAME}"
                        export IMAGE_TAG="${IMAGE_TAG}"

                        docker compose up -d --no-build
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    if curl -fsS \
                        --retry 30 \
                        --retry-delay 2 \
                        --retry-connrefused \
                        http://localhost:8081/actuator/health \
                        -o /tmp/calculator-health.json; then

                        cat /tmp/calculator-health.json
                    else
                        echo "Application health check failed"
                        docker ps
                        docker compose -f "$WORKSPACE/calculator-devops/docker-compose.yml" ps
                        docker compose -f "$WORKSPACE/calculator-devops/docker-compose.yml" logs --tail=100
                        exit 1
                    fi
                '''
            }
        }
    }

    
    post {
        success {
            echo 'CI/CD pipeline completed successfully!'

            emailext(
                to: 'mishraayush0018@gmail.com',
                subject: "SUCCESS: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """\
                    <h2>Pipeline Successful</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Status:</b> SUCCESS</p>
                    <p><b>Docker Image:</b> ${IMAGE_NAME}:${IMAGE_TAG}</p>
                    <p><b>Console Output:</b> <a href="${BUILD_URL}console">View Logs</a></p>
                """,
                mimeType: 'text/html'
            )
        }

        failure {
            echo 'CI/CD pipeline failed. Check the stage logs.'

            emailext(
                to: 'mishraayush0018@gmail.com',
                subject: "FAILURE: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """\
                    <h2>Pipeline Failed</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Status:</b> FAILURE</p>
                    <p><b>Console Output:</b> <a href="${BUILD_URL}console">View Logs</a></p>
                    <p>Open the console logs to identify the failed stage.</p>
                """,
                mimeType: 'text/html'
            )
        }

        always {
            sh 'docker image prune -f || true'
        }
    }

}